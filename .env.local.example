# 실제 값은 .env.local에 채워 넣고 커밋하지 않는다.

# 제보(/submit) 페이지에 표시할 운영자 이메일 — 사용자가 직접 메일로 제보를 보낸다
NEXT_PUBLIC_SUBMIT_EMAIL=

# 사이트맵/OG 절대 URL 생성을 위한 배포 도메인. 커스텀 도메인을 연결하기 전까지는
# 비워둬도 Vercel이 제공하는 배포 도메인(VERCEL_PROJECT_PRODUCTION_URL)으로 자동 대체된다.
NEXT_PUBLIC_SITE_URL=

# Google AdSense 승인 후 발급받는 게시자 ID (예: ca-pub-1234567890123456).
# 설정하면 사이트 소유 확인 메타 태그, 광고 스크립트, ads.txt가 자동으로 활성화된다.
# 승인 전에는 비워둔다.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX). 설정하면 방문 통계 수집이 활성화된다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
