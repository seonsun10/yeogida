# 실제 값은 .env.local에 채워 넣고 커밋하지 않는다.

# 제보(/submit) 페이지에 표시할 운영자 이메일 — 사용자가 직접 메일로 제보를 보낸다
NEXT_PUBLIC_SUBMIT_EMAIL=

# 사이트맵/OG/canonical에 사용할 운영 도메인.
# 비워두면 실제 운영 주소 https://yeogida-life.com 을 사용한다.
NEXT_PUBLIC_SITE_URL=

# Google AdSense 계정에서 제공하는 게시자 ID (예: ca-pub-1234567890123456).
# 설정하면 사이트 소유 확인 메타 태그, 광고 스크립트, ads.txt가 자동으로 활성화된다.
# 사이트 소유 확인·심사 연결에 사용할 수 있다. 설정 여부가 광고 게재 승인을 뜻하지는 않는다.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX). 설정하면 방문 통계 수집이 활성화된다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console 소유 확인 코드. Search Console에서 속성 추가 후
# "HTML 태그" 인증 방식을 선택하면 content="..." 값을 볼 수 있다. 그 값만 넣는다.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# "잘못된 정보 신고" 기능이 사용하는 Neon Postgres 연결 문자열.
# `vercel integration add neon`으로 프로비저닝 후 `vercel env pull .env.local --yes`로 자동 채워진다.
DATABASE_URL=
